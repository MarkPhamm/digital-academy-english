# Sao chép thành .env.local rồi điền giá trị (không commit .env.local).

# API key của Anthropic cho Trợ lý AI (route /api/chat). Lấy tại https://platform.claude.com/settings/keys
# Khi deploy (Netlify), khai báo biến này trong Environment variables của site.
ANTHROPIC_API_KEY=

# Host được phép mở dev server qua mạng LAN, cách nhau bởi dấu phẩy, vd: 192.168.1.38
DEV_ORIGINS=
