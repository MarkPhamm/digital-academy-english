# Sao chép thành .env.local rồi điền giá trị (không commit .env.local).

# API key của Anthropic cho Trợ lý AI (Netlify Function /api/chat, chạy local bằng `netlify dev`).
# Lấy tại https://platform.claude.com/settings/keys. Khi deploy, khai báo biến này trong
# Environment variables của site trên Netlify (xem README).
ANTHROPIC_API_KEY=

# Host được phép mở dev server qua mạng LAN, cách nhau bởi dấu phẩy, vd: 192.168.1.38
DEV_ORIGINS=
